```{r}
ggplot() +
  geom_point(data = pca_scores,
             aes(x = PC1, y = PC2),
             color = "blue", size = 3) +
  
  geom_text(data = pca_scores,
            aes(x = PC1, y = PC2, label = pond_id),
            nudge_y = 0.2, size = 4) +
  
  geom_segment(data = loadings,
               aes(x = 0, y = 0, xend = PC1*2, yend = PC2*2),
               arrow = arrow(length = unit(0.2, "cm")),
               color = "black") +
  
  geom_text(data = loadings,
            aes(x = PC1*2, y = PC2*2, label = var),
            size = 4) +
  
  theme_minimal() +
  labs(title = "PCA Biplot with Pond IDs")
```

