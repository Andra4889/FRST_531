#   # write the label for each cluster analysis (e.g., hc1)
#   `Label` = c("hc1",
#             "...",
#             "...",
#             "..."),
#
#   # write the distance measure used (e.g., Euclidean)
#   `Distance Measure` = c("Euclidean", # for hc1
#                        "...",         # for hc2
#                        "...",         # for hc3
#                        "..."),        # for hc4
#
#   # write the method used (e.g., nearest neighbour/simple)
#   `Method` = c("...",
#              "...",
#              "...",
#              "..."),
#
#   # write the number of clusters based on your interpretation of the dendrogram, and why
#   `Number Of Clusters` = c("...",
#             "...",
#             "...",
#             "..."),
#
#   # write whether or not chaining occurred, and why
#   `Chaining` = c("...",
#                "...",
#                "...",
#                "..."),
#
#   # write whether there was clear separation by distance between the clusters, and why
#   `Separation` = c("...",
#                "...",
#                "...",
#                "...")
#
#   )
#
# ## Knit the table. Remember to include a table caption at the top of the table.
# knitr::kable(answer2.0, row.names = NA,
#              caption = "Table 1. Cluster results for ...")
answer2.0 <- data.frame(
`Label` = c("hc1",
"hc2",
"hc3",
"hc4"),
`Distance Measure` = c("Euclidean",
"Euclidean",
"Euclidean (standardized variables)",
"Euclidean"),
`Method` = c("Complete linkage",
"Single linkage (nearest neighbour)",
"Complete linkage (standardized data)",
"Ward's method"),
`Number Of Clusters` = c("2 clusters, possibly 3. In the dendrogram, 2 clear clusters emerge on the left and right. On the right, though, another separate branch emerges but only for one site (B_E12). However, this may represent an outlier.",
"1 cluster. In the dendrogram, chaining on the right complicates things. B_E12 emerges as a separate possible cluster again, but might be an outlier. Otherwise, 1 cluster appears around a height of 3.",
"3 clusters. The dendrogram shows three major branches before the final merge at about height 9. One large branch occurs on the left, merging with the rest of the sites at around height 8, while two additional branches occur on the right and merge at lower heights (~6). The large vertical distances between these merges suggest that these groups of sites are relatively dissimilar and thus represent meaningful clusters.",
"2 clusters. The Ward’s dendrogram shows two clear, large groups on the left and right that both remain distinct from ~11 height until merging at a very high dissimilarity level of ~18, indicating strong separation between them."),
`Chaining` = c("No strong chaining. In the dendogram, there might be some slight chaining on the left after the break at height 7. However, the clusters are still tightly grouped after this break, without a clear visual pattern indicating strong chaining.",
"Yes, chaining is evident. Sites merge quickly and sequentially from the right to the left until a height of 3. The ladder-like appearance with low heights suggests a chaining event.",
"No evident chaining. Sites form compact subclusters that merge at progressively higher heights, with no ladder-like structure that would indicate chaining.",
"No chaining. For one, Ward’s method minimizes within cluster variance, producing compact clusters. Second, the there is no ladder-like structure evident in the dendrogram. The sites form compact subclusters and merge at progressively higher heights."),
`Separation` = c("Moderate separation. Vertical distance represents dissimilarity. There is a 6-height separation between the top and the closest clusters showing less dissimilarity, but the clusters thereafter are closer in vertical distance, displaying more dissimilarity afterward.",
"Weak separation. In the dendrogram, clusters merge very gradually with little distance gaps between groups until a height of ~3.",
"Strong separation. Sites begin to merge within clusters at relatively low heights, but the clusters only merge at much higher distances (~8), indicating clear differences between groups.",
"Very strong separation. The large vertical distance before the final merge indicates the two clusters are highly dissimilar.")
)
knitr::kable(answer2.0, row.names = NA,
caption = "Table 1. Comparison of hierarchical clustering methods used to group sites based on bird composition.",
align = "l")
