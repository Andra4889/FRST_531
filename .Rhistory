veg.fac1$Structure
veg.fac1$complexity
mean(veg.fac1$complexity)
round(cor(xdata, veg.fac1$scores), 2)
round(cor(veg.fac1$scores, veg.fac1$scores), 2)
Xscaled <- scale(xdata, center = TRUE, scale = TRUE)
head(Xscaled)
dim(veg.fac1$weights)
myscores <- Xscaled %*% veg.fac1$weights
head(myscores)
