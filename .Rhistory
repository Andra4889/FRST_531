sum(PC1^2) + sum(PC2^2)
11 - (sum(PC1^2) + sum(PC2^2))
commonbyX <- PC1^2 + PC2^2
commonbyX
sum(commonbyX)
uniquebyX <- 1 - (PC1^2 + PC2^2)
uniquebyX
sum(uniquebyX)
sum(commonbyX) + sum(uniquebyX)
